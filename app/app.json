{
  "expo": {
    "name": "NowThere",
    "slug": "nowthere",
    "version": "0.2.0",
    "scheme": "nowthere",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#F4EBD7"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "bundleIdentifier": "com.nowthere.app",
      "supportsTablet": true
    },
    "android": {
      "package": "com.nowthere.app",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "INTERNET"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#F4EBD7"
      },
      "config": {
        "googleMaps": {
          "apiKey": "REPLACE_WITH_GOOGLE_MAPS_ANDROID_KEY_FOR_APK_BUILDS"
        }
      }
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "지금 있는 장소의 소식을 보여주고, 게시물이 실제 현장에서 올라왔는지 확인하기 위해 위치를 사용합니다."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "현장 사진을 공유하기 위해 사진 보관함에 접근합니다.",
          "cameraPermission": "지금 이 순간을 촬영해 공유하기 위해 카메라를 사용합니다."
        }
      ]
    ]
  }
}
